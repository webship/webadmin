# Ignore node modules
node_modules
/*/node_modules

# Ignore local gitlab-ci-local runtime + sidecar config.
# The canonical pipeline lives in .gitlab-ci.yml; the local CI is per-developer.
.gitlab-ci-local/
.gitlab-ci-local.yml
.cucumber.js.bak

# Ignore Claude Code project-scope MCP config (per-developer tooling).
.mcp.json

# Yarn 4 cache and install state.
.yarn/

# JavaScript lockfiles are not committed: installs resolve from package.json
# (packageManager yarn@4.18.1, engines).
yarn.lock
package-lock.json
pnpm-lock.yaml
